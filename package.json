{
  "name": "hostpilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hostpilot --local",
    "db:migrate:remote": "wrangler d1 migrations apply hostpilot --remote",
    "typecheck": "tsc --noEmit",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "preact": "^10.26.4",
    "preact-render-to-string": "^6.5.13"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wrangler": "^4.7.1"
  }
}
