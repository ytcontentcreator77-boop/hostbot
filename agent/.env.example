PORT=8788
PROJECT_ROOT=/srv/hostpilot/projects
DOCKER_SOCKET=/run/user/1000/docker.sock
HOSTPILOT_AGENT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHAR_SECRET
CONTROL_PLANE_URL=https://YOUR-HOSTPILOT-WORKER-DOMAIN
NODE_TOKEN=PASTE_ONE_TIME_TOKEN_FROM_ADMIN_SERVER_REGISTRATION

# Optional: GitHub Personal Access Token with access to the target backup repository.
# Keep this only in the VPS agent's protected environment; never put it in HostPilot or source control.
GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN
GITHUB_BACKUP_REPOSITORY=YOUR_GITHUB_OWNER/YOUR_DEDICATED_BACKUP_REPOSITORY

# Project-only SSH gateway. Open this TCP port on the VPS firewall; never expose the agent API port.
TERMINAL_SSH_BIND=0.0.0.0
TERMINAL_SSH_PORT=2222
TERMINAL_SSH_HOST_KEY=/srv/hostpilot/ssh/host_ed25519
